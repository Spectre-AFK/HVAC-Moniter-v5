{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hvac-moniter-v5",
  "compatibility_date": "2026-08-19",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  // Runs the sensor alert check (worker/index.js `scheduled` handler) every 5 minutes.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Not secret (same values already exposed to the client via VITE_ env vars).
  // Real values committed directly — `wrangler deploy` overwrites dashboard-set vars with
  // whatever is here on every deploy, so leaving these blank silently breaks production.
  "vars": {
    "SUPABASE_URL": "https://swbcwtrijguodjaxyitm.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_iVV7-ht6QWT2cqYg_MxWfg_cdPRWd2Y",
    "ALERT_FROM_EMAIL": "alerts@checkmytemp.com"
  }
}
