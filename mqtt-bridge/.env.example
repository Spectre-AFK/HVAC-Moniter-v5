# MQTT broker (must match the ESP32 boards' configured server/port)
MQTT_URL=mqtt://192.168.0.132:1883
# Required once the broker enforces auth (see esp32 code/config.h MQTT_USERNAME/MQTT_PASSWORD)
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=home/sensors/temp

# Supabase project (service role key bypasses RLS — never expose this to a browser/client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
